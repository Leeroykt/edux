# Copy this file to .env.local and fill it in. .env.local is never committed.

# Signs sign-in sessions. Use a random value of at least 32 characters in production.
JWT_SECRET=

# The site's public address, used for the Google sign-in redirect. Leave empty locally.
APP_URL=

# Sign in with Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# Authorised redirect URI: http://localhost:3000/api/v1/auth/google/callback (and the same path on your live site).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: the scoring and rewriting model service.
MODEL_SERVICE_URL=
